{
  "name": "naf/alexa",
  "description": "Alexa+ MCP integration, OAuth setup and diagnostics for NAF.",
  "license": "MIT",
  "type": "naf-plugin",
  "authors": [{"name": "Flo Knapp", "email": "office@florianknapp.de"}],
  "require": {
    "php": ">=8.3",
    "ext-mbstring": "*",
    "naf/cli": "^0.2.3",
    "naf/database": "^0.2.4",
    "naf/framework": "^0.2.8",
    "naf/mcp": "^0.2.5",
    "naf/oauth-server": "^0.2.4"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "3.95.25",
    "phpunit/phpunit": "^12.1"
  },
  "autoload": {"psr-4": {"Naf\\Alexa\\": "src/"}},
  "autoload-dev": {"psr-4": {"Tests\\": "tests/"}},
  "scripts": {
    "test": "phpunit --colors=always",
    "style:check": "@php vendor/bin/php-cs-fixer fix --dry-run --diff",
    "style:fix": "@php vendor/bin/php-cs-fixer fix"
  },
  "config": {"platform": {"php": "8.3.0"}},
  "extra": {"naf": {"boot": {"after": ["naf/cli", "naf/database", "naf/oauth-server", "naf/mcp"]}}}
}
